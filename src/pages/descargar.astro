---
import MainLayout from "../layouts/mainLayout.astro";
---

<MainLayout title="Descargar MiniRadio - Tu aplicación de radio ligera">
  <div class="bg-white dark:bg-gray-800">
    <div class="max-w-7xl mx-auto py-16 px-4 sm:py-24 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl sm:tracking-tight lg:text-6xl">
          Descarga MiniRadio
        </h1>
        <p class="mt-5 max-w-xl mx-auto text-xl text-gray-500 dark:text-gray-300">
          Disponible próximamente en las siguientes plataformas
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:gap-12">
        <!-- Google Play Store -->
        <div class="relative rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-6 py-8 shadow-sm flex items-center space-x-6 hover:border-gray-400 dark:hover:border-gray-500 focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-indigo-500">
          <div class="flex-shrink-0">
            <img class="h-16 w-16" src="https://play.google.com/intl/en_us/badges/static/images/badges/es-419_badge_web_generic.png" alt="Google Play Store" />
          </div>
          <div class="flex-1 min-w-0">
            <a href="#" class="focus:outline-none">
              <span class="absolute inset-0" aria-hidden="true"></span>
              <p class="text-lg font-medium text-gray-900 dark:text-white">Google Play Store</p>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-300">Próximamente disponible</p>
            </a>
          </div>
          <div class="flex-shrink-0">
            <span class="inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200">
              Coming Soon
            </span>
          </div>
        </div>

        <!-- Windows -->
        <div class="relative rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-6 py-8 shadow-sm flex items-center space-x-6 hover:border-gray-400 dark:hover:border-gray-500 focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-indigo-500">
          <div class="flex-shrink-0">
            <svg class="h-16 w-16 text-gray-400 dark:text-gray-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M0 0h11.377v11.373H0zm12.623 0H24v11.373H12.623zM0 12.623h11.377V24H0zm12.623 0H24V24H12.623z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <a href="#" class="focus:outline-none">
              <span class="absolute inset-0" aria-hidden="true"></span>
              <p class="text-lg font-medium text-gray-900 dark:text-white">Windows</p>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-300">Próximamente disponible</p>
            </a>
          </div>
          <div class="flex-shrink-0">
            <span class="inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200">
              Coming Soon
            </span>
          </div>
        </div>
      </div>

      <!-- Nota informativa -->
      <div class="mt-12 text-center">
        <p class="text-base text-gray-500 dark:text-gray-300">
          ¿Quieres ser el primero en saber cuando esté disponible? 
          <a href="mailto:contacto@miniradio.com" class="font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300">
            Contáctanos
          </a>
        </p>
      </div>
    </div>
  </div>
</MainLayout> 